#!/usr/bin/env sh
set -eu

repository_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$repository_root/scripts/validate.ps1"
fi

if command -v powershell >/dev/null 2>&1; then
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$repository_root/scripts/validate.ps1"
fi

echo "A PowerShell host (pwsh or powershell) is required to run the repository validation hook." >&2
exit 1
